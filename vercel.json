{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/kanzlei-websites",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/kanzlei-websites-v2",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/arztpraxis-websites",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/zahnarzt-websites",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/lawyers",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/doctors",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/handwerker-system",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/mandate-kanzlei-mannheim",
      "destination": "/leistungen/google-ads",
      "permanent": true
    },
    {
      "source": "/new-landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/website-analyse",
      "destination": "/website-check",
      "permanent": true
    },
    {
      "source": "/hasan",
      "destination": "/referenzen/dogru",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/services/website",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/website",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/webdesign",
      "destination": "/leistungen/webdesign",
      "permanent": true
    },
    {
      "source": "/services/seo",
      "destination": "/leistungen/seo",
      "permanent": true
    },
    {
      "source": "/seo",
      "destination": "/leistungen/seo",
      "permanent": true
    },
    {
      "source": "/services/google-ads",
      "destination": "/leistungen/google-ads",
      "permanent": true
    },
    {
      "source": "/google-ads",
      "destination": "/leistungen/google-ads",
      "permanent": true
    },
    {
      "source": "/blog/5-elements-every-high-converting-website-needs",
      "destination": "/blog/5-elemente-high-converting-website-2026",
      "permanent": true
    },
    {
      "source": "/blog/improve-google-rankings-germany",
      "destination": "/blog/google-ranking-verbessern-deutschland",
      "permanent": true
    },
    {
      "source": "/blog/web-design-for-lawyers-law-firms",
      "destination": "/blog/webdesign-fuer-anwaelte-kanzleien",
      "permanent": true
    },
    {
      "source": "/blog/freelancer-vs-agency-website",
      "destination": "/blog/freelancer-oder-agentur-website",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/"
    },
    {
      "source": "/onboarding",
      "destination": "/"
    },
    {
      "source": "/onboarding/(.*)",
      "destination": "/"
    },
    {
      "source": "/interview/(.*)",
      "destination": "/interview/shell"
    },
    {
      "source": "/tr/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/onboarding",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/onboarding/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://nuell-agentur.com/sitemap.xml>; rel=\"sitemap\""
        }
      ]
    }
  ]
}
